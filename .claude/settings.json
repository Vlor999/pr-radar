{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git switch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune *)",
      "Bash(git push -u origin *)",
      "Bash(git push)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run demo)",
      "Bash(npm run build)",
      "Bash(npm run tauri build *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(npx shadcn add *)",
      "Bash(npx shadcn@latest add *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *refs/heads/main*)",
      "Bash(git push * --delete *)",
      "Bash(git push --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * :dev*)",
      "Bash(git push * :main*)",
      "Bash(git push * :refs/heads/*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --prune*)",
      "Bash(git push * --all*)",
      "Bash(git branch -d dev)",
      "Bash(git branch -D dev)",
      "Bash(git branch -d main)",
      "Bash(git branch -D main)",
      "Bash(git branch --delete dev)",
      "Bash(git branch --delete main)",
      "Bash(git branch -d * dev)",
      "Bash(git branch -D * dev)",
      "Bash(git branch --delete * dev)",
      "Bash(git branch -d * main)",
      "Bash(git branch -D * main)",
      "Bash(git branch --delete * main)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git worktree remove --force *)",
      "Bash(git worktree remove -f *)",
      "Bash(gh pr * --reviewer*)",
      "Bash(gh pr * --add-reviewer*)",
      "Bash(gh pr create * -r *)",
      "Bash(gh api *requested_reviewers*)",
      "Read(~/.tauri/pr-radar.key)",
      "Bash(*pr-radar.key)",
      "Bash(*pr-radar.key *)",
      "Bash(*pr-radar.key\")",
      "Bash(*pr-radar.key\"*)",
      "Bash(echo *TAURI_SIGNING_PRIVATE_KEY*)",
      "Bash(printf *TAURI_SIGNING_PRIVATE_KEY*)",
      "Bash(printenv TAURI_SIGNING_PRIVATE_KEY*)"
    ]
  }
}
