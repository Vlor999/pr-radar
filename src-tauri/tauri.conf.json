{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Radar",
  "version": "0.3.5",
  "identifier": "io.github.vlor999.prradar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PR Radar",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Vos PR GitHub ouvertes, en arbre",
    "publisher": "Vlor999",
    "copyright": "MIT",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMUU3MDdBMEExNEQ0ODkKUldTSjFCUUtlbkFlalhjRDRnRlh4Tnd4eXpvVTlIS1JCWGJIc0I3OEplTiswKzVWRUloQ1UvNDkK",
      "endpoints": [
        "https://github.com/Vlor999/pr-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
